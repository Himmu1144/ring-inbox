# Fill the right side of each line. No quotes, no spaces around "=".
# This file is in .gitignore, so it never goes to GitHub.

# ---------- Gemini (the AI that decides) ----------
# From https://aistudio.google.com/apikey  (looks like: AIzaSy...)
GEMINI_API_KEY=
# Groq, tried first (fast). From console.groq.com/keys
GROQ_API_KEY=
# Groq models, tried in order, then the Gemini ones below.
# Second Groq account (optional). Own rate limit, tried after the first key.
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Gemini models, tried after Groq, in order.
GEMINI_MODEL=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# ---------- Twilio (the phone call) ----------
# All three are on the Twilio Console home page (console.twilio.com)
# Account SID looks like: AC followed by 32 letters/numbers
TWILIO_ACCOUNT_SID=
# Auth Token: click "show" next to it on the console home page (32 letters/numbers)
TWILIO_AUTH_TOKEN=
# Your Twilio number with + and country code, no spaces. Example format: +15551234567
TWILIO_FROM_NUMBER=

# ---------- Throwaway Gmail (the real inbox) ----------
# Full address, example format: ringinbox.demo@gmail.com
GMAIL_ADDRESS=
# 16-letter app password from Google. Paste it WITHOUT the spaces. Example format: abcdefghijklmnop
GMAIL_APP_PASSWORD=

# ---------- Your own phone (only for testing tonight) ----------
# Where the test calls in step 2 ring. Example format: +919876543210
MY_PHONE=

# ---------- Safety (leave as is) ----------
MAX_CALLS_PER_DAY=10

# Real Gmail inbox mode on the page. "on" only on your own laptop, "off" on the public site.
REAL_INBOX=off
